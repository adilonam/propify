DATABASE_URL="postgresql://postgres:postgres@localhost:5432/propify?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Whop Account API key (Dashboard → Developer → Account API Keys)
WHOP_API_KEY=""
# Whop company / account id (prefixed biz_…) from the Whop dashboard
WHOP_COMPANY_ID="biz_xxxxxxxxxxxxx"
# Whop webhook signing secret (Dashboard → Developer → Webhooks → Secret). Keep the ws_ prefix.
WHOP_WEBHOOK_SECRET=""
# Optional. Omit to use the Whop SDK production default. Set for sandbox:
# WHOP_API_BASE_URL="https://sandbox-api.whop.com/api/v1"
WHOP_API_BASE_URL=
